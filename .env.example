# PyMax authorization.
# sms: PyMax Client with phone/SMS auth.
# qr: PyMax WebClient with QR auth; the QR URL is printed to logs.
MAX_PYMAX_AUTH=qr
# MAX_PHONE=+79990000000
# MAX_2FA_PASSWORD=optional_2fa_password
# MAX_PYMAX_WORK_DIR=state/pymax
# MAX_PYMAX_SESSION_NAME=pymax-sms.db

# (Optional) Max chat IDs to listen, comma-separated. Leave unset to listen to all chats.
# MAX_CHAT_IDS=-123,-456
# (Optional) Max chat IDs to always skip, comma-separated. Takes precedence
# over MAX_CHAT_IDS — useful to silence one noisy chat while still listening
# to everything else.
# MAX_IGNORE_CHAT_IDS=-789,-101112

# Telegram bot token (get from @BotFather)
TG_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ID of the DEFAULT Telegram SUPERGROUP with Topics (forum) enabled.
# The bot must be an admin there with the "Manage Topics" permission.
# It is a negative number, e.g. -1001234567890.
# Used for bot-status messages, and as the fallback target for any Max chat
# that isn't explicitly routed elsewhere (see MAX_CHAT_ROUTES below) and
# hasn't been bound yet via /bind or /add.
#
# You are NOT limited to this one group: add the bot as admin (with "Manage
# Topics") to as many Telegram supergroups as you like, and use /bind or /add
# inside each one to route specific Max chats there. Each Max chat still
# gets its own auto-created topic — just in whichever group it's routed to.
TG_CHAT_ID=-1001234567890

# (Optional) Pre-configure which Max chat goes to which Telegram supergroup,
# so brand-new incoming chats land in the right place on the very first
# message instead of falling back to TG_CHAT_ID. JSON object: Max chat id ->
# target Telegram chat id. Chats not listed here use TG_CHAT_ID until you
# /bind them somewhere specific.
# MAX_CHAT_ROUTES={"-75107924425434": -1002233445566, "123456": -1009988776655}

# (Optional) Restrict who may reply back to Max — comma-separated Telegram
# user IDs (@userinfobot). If unset, anyone in the supergroup can reply.
# TG_ALLOWED_USER_IDS=123456789,987654321

# (Optional) SOCKS5 proxy for Telegram (e.g. socks5://user:pass@host:port)
# TG_PROXY=socks5://127.0.0.1:1080

# (Optional) Directory for persistent state (topic mapping). Default: state
# STATE_DIR=state

# Debug mode: verbose logs (true/false). Does NOT dump raw JSON — see
# DEBUG_DUMP_JSON below for that (kept separate since dumped JSON can
# contain tokens/phone numbers even after redaction misses an edge case).
DEBUG=false

# (Optional) Additionally dump the first ~20 incoming events + the initial
# snapshot as JSON files under debug/, with known-sensitive fields (tokens,
# auth, phone numbers, etc.) redacted. Useful when debugging attach parsing.
# DEBUG_DUMP_JSON=false

# (Optional) Max size for files/photos/videos downloaded FROM Max, in MB.
# Protects memory against a huge/broken response. Default: 50
# MAX_DOWNLOAD_MB=50

# (Optional) Max size for files uploaded TO Telegram, in MB (Telegram's own
# bot-API hard limit is 50MB unless you run a local Bot API server).
# Default: 50
# TG_UPLOAD_MB=50

# (Optional) Port for a tiny HTTP /health endpoint (200 while the Max
# WebSocket is connected & authorized, 503 otherwise) — for Docker
# HEALTHCHECK / orchestrator probes. Unset = no health server.
# HEALTH_PORT=8080

# Allow replies from Telegram topics back to Max (true/false)
REPLY_ENABLED=true
